aws_region   = "us-east-2"
project_name = "absencesbo"
environment  = "dev"

# Keep administrative access closed by default.
allowed_k3s_cidrs = []

# Public web access for the dev application.
allowed_web_cidrs = ["0.0.0.0/0"]

# Keep the NLB backend/health-check path to app_nodeport reachable from inside the VPC.
allowed_nodeport_cidrs = ["0.0.0.0/0"]

# Network sizing.
vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"

# EC2 sizing.
instance_type     = "t3.medium"
root_volume_type  = "gp3"
root_volume_size  = 30
data_volume_type  = "gp3"
data_volume_size  = 20
data_device_name  = "/dev/sdf"

# k3s service NodePort targeted by the NLB.
app_nodeport = 32322

tags = {
  Owner = "dev"
}
